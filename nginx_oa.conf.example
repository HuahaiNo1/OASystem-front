# 复制为 nginx_oa.conf 后按你的环境修改（nginx_oa.conf 已加入 .gitignore 勿提交）
# 反向代理
upstream oa {
  server unix:///data/sock/oa.sock;
}

# 虚拟主机
server {
  listen 80;
  # 替换为实际域名或本机/内网 IP
  server_name 127.0.0.1;
  charset utf-8;
  client_max_body_size 10M;
  location / {
    root /www/dist;
    index index.html;
  }
  location /assets {
    alias /www/dist/assets;
  }
  location /static {
    alias /www/static;
  }
  location /api {
    include /etc/nginx/uwsgi_params;
    uwsgi_pass oa;
  }
  access_log /data/log/access.log;
  error_log /data/log/error.log;
}
